# Supabase project credentials
# Find these at: Supabase Dashboard → Settings → API
SUPABASE_URL={/hehe/}
SUPABASE_SERVICE_KEY={Keep_It_Secret}

# Session secret (any random string, keep it secret)
SESSION_SECRET=replace-with-a-long-random-string

# First admin user (used by: npm run seed)
ADMIN_EMAIL={...}
ADMIN_PASSWORD={...}

# Server port
PORT=3000

# Business timezone used to date uploads (IANA name, optional; default Asia/Kolkata)
# TZ=Asia/Kolkata

# Stock count at or below which a product is "Low" (optional, default 10)
# LOW_STOCK_THRESHOLD=10
