# Supabase project credentials
# Find these at: Supabase Dashboard → Settings → API
SUPABASE_URL={/hehe/}
SUPABASE_SERVICE_KEY={Keep_It_Secret}

# Session secret (any random string, keep it secret)
SESSION_SECRET=replace-with-a-long-random-string

# First admin user (used by: npm run seed)
ADMIN_EMAIL={...}
ADMIN_PASSWORD={...}

# Server port
PORT=3000

# Business timezone used to date uploads (IANA name, optional; default Asia/Kolkata)
# TZ=Asia/Kolkata

# Stock count at or below which a product is "Low" (optional, default 10)
# LOW_STOCK_THRESHOLD=10
# Show per-product profit on Sales > Month by month only to admins (optional, default false = everyone logged in)
# PRODUCT_PROFIT_ADMIN_ONLY=false

# Strategy tab: key for the AI that writes the strategy text (Generate button). Without it the health strip still works.
OPENROUTER_API_KEY=sk-or-...
STRATEGY_MODEL=<an OpenRouter model id>
# Optional: model for the Strategy tab (default claude-sonnet-5-5)
# STRATEGY_MODEL=claude-sonnet-5-5
