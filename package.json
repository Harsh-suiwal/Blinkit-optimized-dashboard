{
  "name": "blinkit-dashboard",
  "version": "1.0.0",
  "description": "Blinkit optimized analytics dashboard — inventory, sales, and campaign reporting",
  "main": "server.js",
  "scripts": {
    "serve": "node server.js",
    "server": "node server.js",
    "dev": "npx concurrently \"npx nodemon server.js\" \"npm run dev:client\"",
    "install:client": "npm --prefix client ci --include=dev",
    "build": "npm run install:client && npm run build:client",
    "start": "npm run build && node server.js",
    "seed": "node db/seed-admin.js",
    "build:client": "npm --prefix client run build",
    "dev:client": "npm --prefix client run start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.3",
    "express": "^4.21.2",
    "express-session": "^1.19.1",
    "multer": "^1.4.5-lts.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  }
}
