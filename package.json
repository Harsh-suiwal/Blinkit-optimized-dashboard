{
  "name": "blinkit-dashboard",
  "version": "1.0.0",
  "description": "Phase 1 MVP - Blinkit inventory report dashboard",
  "main": "server.js",
  "scripts": {
    "serve": "node server.js",
    "server": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"npm run dev:client\"",
    "install:client": "npm --prefix client ci --include=dev",
    "build": "npm run install:client && npm run build:client",
    "start": "npm run build && node server.js",
    "seed": "node db/seed-admin.js",
    "build:client": "npm --prefix client run build",
    "dev:client": "npm --prefix client run start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^18.0.3",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.14",
    "xlsx": "^0.18.5"
  }
}
